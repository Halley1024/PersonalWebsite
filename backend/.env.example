# 配置示例；Config 读取进程环境变量，不会自动加载这个文件。
APP_ENV=development
BIND_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://website_user:replace_me@127.0.0.1:5432/personal_website
DATABASE_POOL_SIZE=5
DATABASE_ACQUIRE_TIMEOUT=5
MEDIA_ROOT=./data/media
LOG_LEVEL=info
DISPLAY_TIMEZONE=Asia/Shanghai
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
VISITOR_HMAC_KEY_VERSION=1
# 只有真正位于反向代理后面时才配置它，并确保代理覆盖访客伪造的转发头。
TRUSTED_PROXIES=
# 可选：本地 CIDR 区域数据 JSON 文件，未提供时区域为 unknown。
# GEOIP_FILE=/absolute/path/to/regions.json
# 生产要求 DATABASE_URL_FILE、VISITOR_HMAC_KEY_FILE 和 HTTPS PUBLIC_ORIGIN。
# DATABASE_URL_FILE=/run/secrets/database_url
# VISITOR_HMAC_KEY_FILE=/run/secrets/visitor_hmac_key
